DATABASE_URL="postgresql://dntech:dntech123@localhost:5432/dntech?schema=public"
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_REFRESH_SECRET="change-this-to-a-different-secure-random-string-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
# Set TRUST_PROXY=1 in production (behind Nginx)
# TRUST_PROXY=1
UPLOAD_DIR=./uploads
ADMIN_EMAIL=admin@dntech.id
ADMIN_PASSWORD=Admin@123456
FRONTEND_URL=http://localhost:3000

# Email SMTP (V5) — production should set SMTP_PASSWORD from mailspace account
SMTP_HOST=mx8.mailspace.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FAMILY=4
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_USER=info@dntech.id
SMTP_PASSWORD=
SMTP_FROM_NAME=DN Tech
SMTP_FROM_EMAIL=info@dntech.id
EMAIL_QUEUE_ENABLED=true
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=1000
EMAIL_RATE_LIMIT=10
ADMIN_EMAIL=info@dntech.id

# Legacy SendGrid vars kept for compatibility; SMTP is preferred in V5
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@dntech.id
SALES_EMAIL=sales@dntech.id

