{
  "name": "dntech-backend",
  "version": "1.0.0",
  "description": "DN Tech Company Profile API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prebuild": "prisma generate",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-branding": "tsx scripts/seed-branding.ts",
    "db:seed-homepage": "tsx scripts/seed-homepage.ts",
    "db:clear-content": "tsx scripts/clear-content.ts",
    "db:seed-dnpeople": "tsx scripts/seed-dnpeople-product.ts",
    "db:seed-dncore": "tsx scripts/seed-dncore-product.ts",
    "db:seed-dnshop": "tsx scripts/seed-dnshop-product.ts",
    "db:seed-nearwork": "tsx scripts/seed-nearwork-product.ts",
    "db:seed-dvs": "tsx scripts/seed-dvs-product.ts",
    "db:seed-threads-automation": "tsx scripts/seed-threads-automation-product.ts",
    "db:seed-trusted-jurist": "tsx scripts/seed-trusted-jurist-product.ts",
    "db:seed-products": "tsx scripts/seed-all-products.ts",
    "db:disable-seed-admin": "tsx scripts/disable-seed-admin.ts",
    "validate:env": "tsx scripts/validate-env.ts",
    "db:vps": "bash ../scripts/db-vps.sh",
    "db:vps:tunnel": "bash ../scripts/db-vps.sh tunnel",
    "db:vps:seed": "bash ../scripts/db-vps.sh seed",
    "postinstall": "prisma generate",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathIgnorePatterns=src/__tests__/integration",
    "test:integration": "jest src/__tests__/integration --runInBand",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "perf:homepage": "k6 run performance/k6/homepage.js",
    "perf:contact": "k6 run performance/k6/contact-form.js",
    "perf:product": "k6 run performance/k6/product-page.js"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^9.0.3",
    "pino": "^9.14.0",
    "uuid": "^11.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.9.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
