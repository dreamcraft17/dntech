# Development
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# GA4 measurement ID (public; baked into the frontend at build time)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-V6262D1WEE
# Optional server-only endpoint for SSR (PM2 example):
# API_INTERNAL_URL=http://127.0.0.1:4000/api/v1

# Production (uncomment & rebuild after editing — NEXT_PUBLIC_* is baked in at build time)
# NEXT_PUBLIC_API_URL=https://api.dntech.id/api/v1
# NEXT_PUBLIC_SITE_URL=https://dntech.id
# API_INTERNAL_URL=http://127.0.0.1:4000/api/v1
# NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ISR cache revalidation. Admin "save" buttons trigger this indirectly via
# the authenticated backend (POST /api/v1/admin/revalidate), which forwards
# to this route using the secret below. Server-only — never prefix this with
# NEXT_PUBLIC_, or it gets baked into the public JS bundle and the endpoint's
# "auth" becomes trivially bypassable. The backend's .env must hold the same
# value as REVALIDATE_SECRET below.
REVALIDATE_SECRET=

# Error monitoring (Sentry). Required in production — leave unset in dev/CI
# and the frontend no-ops (no Sentry project needed locally).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: only needed in CI/prod to upload source maps to Sentry.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
