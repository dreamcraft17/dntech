# Environment variables for the root-level docker-compose.yml.
# Copy this file to `.env` in the repo root and replace every value with a
# real secret before using it in any real (non-local) deployment.

# Postgres database name used by the `db` and `backend` services.
POSTGRES_DB=dntech

# Postgres user used by the `db` and `backend` services.
POSTGRES_USER=dntech

# Postgres password used by the `db` and `backend` services. CHANGE THIS in any real deployment.
POSTGRES_PASSWORD=dntech123

# Secret used by the backend to sign JWTs. MUST be a long random string in any real deployment.
JWT_SECRET=change-this-in-production-use-long-random-string

# Port the backend service listens on inside docker-compose.yml.
PORT=4000

# Public URL of the frontend, used by the backend for things like CORS/redirects.
FRONTEND_URL=http://localhost:3000

# Bootstrap admin account email created by the backend on first run.
ADMIN_EMAIL=admin@dntech.id

# Bootstrap admin account password created by the backend on first run. CHANGE THIS in any real deployment.
ADMIN_PASSWORD=DevOnly-LocalBootstrap-ChangeMe!

# Public API base URL baked into the frontend build/runtime.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Error monitoring (Sentry) DSN, shared by the backend and frontend services in
# docker-compose.yml. MUST be set in any real deployment; both apps no-op
# gracefully (no crash, no reporting) when it is left blank, e.g. in local dev.
SENTRY_DSN=
