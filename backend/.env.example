DATABASE_URL="postgresql://dntech:dntech123@localhost:5432/dntech?schema=public"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Blog generation uses OpenAI-compatible API first, then Gemini as fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
CHATBOT_ENABLED=true
# Blog worker is opt-in. It creates 4 useful articles/day from the topic strategy,
# validates them, schedules them, then publishes at the configured slots.
BLOG_AUTOMATION_ENABLED=false
BLOG_AUTOMATION_POSTS_PER_DAY=4
BLOG_AUTOMATION_SLOTS=09:00,12:00,15:00,18:00
BLOG_AUTOMATION_TIMEZONE=Asia/Jakarta
BLOG_AUTOMATION_PUBLISH_MODE=scheduled
BLOG_AUTOMATION_DRY_RUN=false
BLOG_AUTOMATION_INTERVAL_MS=900000
BLOG_AUTOMATION_MAX_GENERATION_ATTEMPTS=3
BLOG_AUTOMATION_GENERATE_IMAGE=true
# Worker uses OPENAI_API_KEY for cover images.
# Optional; falls back to ADMIN_EMAIL, then the oldest active content admin.
BLOG_AUTOMATION_AUTHOR_EMAIL=
# Image model used when the blog generator creates a cover image.
# gemini-3.1-flash-image is the lower-cost alternative when enabled for your key.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_REFRESH_SECRET="change-this-to-a-different-secure-random-string-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
# Set TRUST_PROXY=1 in production (behind Nginx)
# TRUST_PROXY=1
UPLOAD_DIR=./uploads
ADMIN_EMAIL=admin@dntech.id
# Required in production (min 12 chars). Do not use Admin@123456 or other defaults.
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:3000

# Error monitoring (Sentry). Required in production — leave unset in dev/CI and
# the backend no-ops (no Sentry project needed locally).
SENTRY_DSN=
# Optional: fraction of transactions sampled for performance tracing (0-1).
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email SMTP (V5) — production should set SMTP_PASSWORD from mailspace account
SMTP_HOST=mx8.mailspace.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FAMILY=4
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_USER=info@dntech.id
SMTP_PASSWORD=
SMTP_FROM_NAME=DN Tech
SMTP_FROM_EMAIL=info@dntech.id
EMAIL_QUEUE_ENABLED=true
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=1000
EMAIL_RATE_LIMIT=10
ADMIN_EMAIL=info@dntech.id
CONTACT_NOTIFICATION_EMAIL=info@dntech.id

# Legacy SendGrid vars kept for compatibility; SMTP is preferred in V5
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@dntech.id
SALES_EMAIL=sales@dntech.id

# Frontend env (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_CRISP_WEBSITE_ID=
